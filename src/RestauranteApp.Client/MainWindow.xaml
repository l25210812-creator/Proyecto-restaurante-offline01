<Window x:Class="RestauranteApp.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restaurante — Terminal"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize">
    <!--
        Contenedor único de navegación: se cambia el contenido (Content) entre las
        vistas (Login, MapaMesas, Orden, Cocina, Caja) desde el code-behind según el
        rol del mesero autenticado. Se evita Frame/Page + historial de "atrás" porque
        en una terminal táctil de restaurante no queremos que el usuario pueda navegar
        con gestos inesperados; el flujo lo controla la app explícitamente.
    -->
    <Grid Background="#FFF5F5F5">
        <ContentControl x:Name="ContenidoPrincipal" />
    </Grid>
</Window>
