<UserControl x:Class="RestauranteApp.Client.Views.OrdenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Pantalla principal del mesero: categorías a la izquierda, ítems del menú en el
        centro como botones grandes (touch), carrito a la derecha con el botón crítico
        "Enviar a cocina" — ese botón es el flujo principal de todo el sistema.
    -->
    <Grid Background="#FFFFFFFF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Categorías -->
        <ListBox Grid.Column="0" ItemsSource="{Binding Categorias}"
                 SelectedItem="{Binding CategoriaSeleccionada}"
                 DisplayMemberPath="Nombre" FontSize="18" Background="#FF2C3E50" Foreground="White" />

        <!-- Ítems de la categoría seleccionada, como botones grandes táctiles -->
        <ScrollViewer Grid.Column="1">
            <ItemsControl ItemsSource="{Binding CategoriaSeleccionada.Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button MinWidth="180" MinHeight="100"
                                Command="{Binding DataContext.AgregarAlCarritoCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel>
                                <TextBlock Text="{Binding Nombre}" FontWeight="Bold" FontSize="18"
                                           TextWrapping="Wrap" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Precio, StringFormat='${0:0.00}'}"
                                           FontSize="16" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Carrito local + acción de enviar -->
        <DockPanel Grid.Column="2" Background="#FFECF0F1">
            <Button DockPanel.Dock="Top" Content="&lt; Volver al mapa de mesas" Command="{Binding VolverCommand}" />

            <TextBlock DockPanel.Dock="Top" Text="Orden actual" FontSize="20" FontWeight="Bold" Margin="12,8" />

            <ScrollViewer DockPanel.Dock="Top" MaxHeight="360">
                <ItemsControl ItemsSource="{Binding Carrito}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#FFBDC3C7" BorderThickness="0,0,0,1" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ItemMenu.Nombre}" FontWeight="Bold" FontSize="16" />
                                        <TextBlock Text="{Binding Cantidad, StringFormat='Cantidad: {0}'}" FontSize="14" />
                                        <TextBlock Text="{Binding Importe, StringFormat='${0:0.00}'}" FontSize="14" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Quitar" FontSize="12" MinHeight="40"
                                            Command="{Binding DataContext.QuitarDelCarritoCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock DockPanel.Dock="Top" Text="{Binding TotalCarrito, StringFormat='Total: ${0:0.00}'}"
                       FontSize="20" FontWeight="Bold" Margin="12,8" />

            <TextBlock DockPanel.Dock="Top" Text="{Binding MensajeEstado}" TextWrapping="Wrap"
                       Foreground="#FF2980B9" Margin="12,0" />

            <StackPanel DockPanel.Dock="Bottom" Margin="8">
                <!-- Botón crítico del flujo principal: guarda en BD + imprime en cocina/bar. -->
                <Button Content="ENVIAR A COCINA" Command="{Binding EnviarACocinaCommand}"
                        Background="#FFE67E22" Foreground="White" FontWeight="Bold" FontSize="22" MinHeight="80" />
                <Button Content="Cobrar cuenta" Command="{Binding CobrarCommand}"
                        Background="#FF27AE60" Foreground="White" FontWeight="Bold" FontSize="18" MinHeight="64" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
