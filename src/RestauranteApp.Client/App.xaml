<Application x:Class="RestauranteApp.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RestauranteApp.Client.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <conv:EstadoMesaColorConverter x:Key="EstadoMesaColorConverter" />
            <conv:TextoNoVacioAVisibilidadConverter x:Key="NotasVisibilidadConverter" />
            <!-- Estilo táctil global: botones grandes (mínimo 64px de alto) para dedo,
                 sin depender de mouse/teclado. El diseño visual final (colores, logo)
                 se aplica después; esto solo fija el TAMAÑO mínimo de toque. -->
            <Style TargetType="Button">
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Margin" Value="6" />
                <Setter Property="Padding" Value="12" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="FontSize" Value="20" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
